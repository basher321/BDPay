<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only (spec 13, plan D134): plain HTTP is allowed to the emulator's host address 10.0.2.2, where
     the local Supabase runs. Everything else, and every release build, stays HTTPS-only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
